APP_NAME=DingerIQ API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
DATABASE_URL=postgresql+psycopg://dingeriq:dingeriq@db:5432/dingeriq
MLB_API_BASE=https://statsapi.mlb.com/api/v1
MLB_SEASON=2026
DAILY_REFRESH_HOUR=8
DAILY_REFRESH_MINUTE=0
SAVANT_API_BASE=https://baseballsavant.mlb.com
STATCAST_LOOKBACK_DAYS=2
STATCAST_REFRESH_HOUR=9
STATCAST_REFRESH_MINUTE=30

# Shared secret protecting every /admin endpoint (sent as the X-Admin-Key header).
# When unset, all /admin endpoints deny access.
ADMIN_API_KEY=

# OpenWeather (https://openweathermap.org/api) — required for game weather
OPENWEATHER_API_KEY=
OPENWEATHER_API_BASE=https://api.openweathermap.org
WEATHER_REFRESH_HOURS=3
